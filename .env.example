# AuraAssist environment - copy to .env and fill in. .env is git-ignored.

# Agent engine: mock (deterministic, offline) unless this is exactly "1".
AURA_USE_BEDROCK=0

# --- AWS credentials (only needed when AURA_USE_BEDROCK=1) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# Models. Nova Lite is the intent agent; the vision model is used by vision.py
# when its Bedrock path is enabled.
AURA_AGENT_MODEL=amazon.nova-lite-v1:0
AURA_VLM_MODEL=amazon.nova-lite-v1:0
AURA_REASONING_MODEL=amazon.nova-lite-v1:0
